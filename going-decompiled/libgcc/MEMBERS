# libgcc.a members built from the verbatim GCC source in this directory.
# One row per archive member: <member> <source file> <cpp defines...>
# tools/ee/build_libgcc.sh builds the members a region's linker script names
# (a splat `lib` subsegment, `libgcc.a:<member>.o`) from these rows, and fails
# on a named member with no row here. Rows are exactly GCC's own module
# selection (FINE_GRAINED_LIBRARIES + L_<module>), never a source edit.
_divdi3  libgcc2.c  -DIN_LIBGCC2 -DFINE_GRAINED_LIBRARIES -DL_divdi3
_muldi3  libgcc2.c  -DIN_LIBGCC2 -DFINE_GRAINED_LIBRARIES -DL_muldi3
_fixunsdfdi  libgcc2.c  -DIN_LIBGCC2 -DFINE_GRAINED_LIBRARIES -DL_fixunsdfdi
_floatdidf  libgcc2.c  -DIN_LIBGCC2 -DFINE_GRAINED_LIBRARIES -DL_floatdidf
dp-bit  cygnus-ee/fp-bit.c  -DFLOAT_BIT_ORDER_MISMATCH -DUS_SOFTWARE_GOFAST -DNO_DENORMALS -DFINE_GRAINED_LIBRARIES -DL_pack_df -DL_unpack_df -DL_addsub_df -DL_mul_df -DL_div_df -DL_fpcmp_parts_df -DL_compare_df -DL_si_to_df -DL_df_to_si -DL_df_to_usi -DL_make_df -DL_df_to_sf
fp-bit-pack  cygnus-ee/fp-bit.c  -DFLOAT -DFLOAT_BIT_ORDER_MISMATCH -DUS_SOFTWARE_GOFAST -DNO_DENORMALS -DFINE_GRAINED_LIBRARIES -DL_pack_sf -DL_unpack_sf
fp-bit-make  cygnus-ee/fp-bit.c  -DFLOAT -DFLOAT_BIT_ORDER_MISMATCH -DUS_SOFTWARE_GOFAST -DNO_DENORMALS -DFINE_GRAINED_LIBRARIES -DL_make_sf -DL_sf_to_df
# libm.a members (RULING #9783): not GCC source, so they live in
# going-decompiled/libm/ with their own PROVENANCE, and the source column is
# relative to this directory. build_libgcc.sh archives them into the same
# build/<region>/lib/libgcc.a; the member names are libm.a's own. The defines
# column carries their include path (newlib's fdlibm.h plus the project-written
# shims in libm/shim/, searched after libgcc/shim/, which has none of their
# headers) and newlib's configure.host define for mips64r5900.
s_isnan  ../libm/newlib/libm/math/s_isnan.c  -Igoing-decompiled/libm/shim -Igoing-decompiled/libm/newlib/libm/common -DMALLOC_ALIGNMENT=16
w_sqrt  ../libm/newlib/libm/math/w_sqrt.c  -Igoing-decompiled/libm/shim -Igoing-decompiled/libm/newlib/libm/common -DMALLOC_ALIGNMENT=16
